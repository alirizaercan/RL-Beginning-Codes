# LLM model used by ollama Python client
LLM_MODEL=qwen2.5:7b

# Final score clamp range
REWARD_MIN=-100
REWARD_MAX=100

# Reward rule weights
REWARD_FORWARD_WEIGHT=60
REWARD_STABILITY_WEIGHT=25
REWARD_ENERGY_WEIGHT=10
REWARD_FALL_PENALTY=35
REWARD_STEP_BONUS_WEIGHT=5

# Episode step target used by step bonus
TARGET_STEPS=1600
